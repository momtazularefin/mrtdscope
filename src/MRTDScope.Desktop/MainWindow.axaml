<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MRTDScope.Desktop"
        x:Class="MRTDScope.Desktop.MainWindow"
        Title="MRTDScope"
        WindowStartupLocation="CenterScreen"
        Width="1180" Height="820"
        MinWidth="940" MinHeight="620">

  <Grid ColumnDefinitions="380,*" RowDefinitions="*,Auto">

    <!-- Source, credentials and trust material. The action and the status line are pinned
         below the scrolling part: they are what the user acts on and reads back, and on a
         short window they would otherwise be the first things to scroll out of sight. -->
    <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="*,Auto">

    <!-- The inset is a margin on the content, not padding on the ScrollViewer: with padding,
         the theme's scrollbar leaves the right edge of the widest row (the Refresh button)
         clipped against the column boundary. -->
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="14" Margin="16">

        <TextBlock Text="MRTDScope" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="An eMRTD inspection instrument. Every security check is reported by name, with its evidence."
                   TextWrapping="Wrap" FontSize="12" />

        <TextBlock Text="SOURCE" FontSize="11" FontWeight="Bold" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton x:Name="ReaderSourceOption" GroupName="Source" Content="PC/SC reader" IsChecked="True" />
          <RadioButton x:Name="SyntheticSourceOption" GroupName="Source" Content="Synthetic" />
        </StackPanel>

        <!-- Reader selection. -->
        <StackPanel x:Name="ReaderPanel" Spacing="6">
          <TextBlock Text="Reader" FontSize="12" />
          <!-- The placeholder only ever shows while the list is empty, and the code-behind
               disables the box in that state: dimmed text on a disabled control reads as
               unavailable rather than as unreadable, and the hint below carries the detail. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="ReaderBox" Grid.Column="0" HorizontalAlignment="Stretch"
                      PlaceholderText="No reader found" />
            <Button x:Name="RefreshReadersButton" Grid.Column="1" Content="Refresh" />
          </Grid>
          <TextBlock x:Name="ReaderHint" TextWrapping="Wrap" FontSize="11"
                     Text="An eMRTD is a contactless document, so a contact interface cannot read it." />
        </StackPanel>

        <!-- Synthetic document selection. -->
        <StackPanel x:Name="SyntheticPanel" Spacing="6" IsVisible="False">
          <TextBlock Text="Fault to inject" FontSize="11" />
          <ComboBox x:Name="FaultBox" HorizontalAlignment="Stretch" />
          <CheckBox x:Name="SyntheticPaceOption" Content="Advertise PACE, Chip and Active Authentication" />
          <TextBlock TextWrapping="Wrap" FontSize="11"
                     Text="A document MRTDScope generates itself, so the whole chain can be demonstrated with no reader and no real passport." />
        </StackPanel>

        <StackPanel x:Name="MrzPanel" Spacing="8">
          <TextBlock Text="MACHINE READABLE ZONE" FontSize="11" FontWeight="Bold" Margin="0,8,0,0" />
          <TextBlock Text="The access key is derived from these three fields. Enter them exactly as printed, filler characters included."
                     TextWrapping="Wrap" FontSize="11" />

          <!-- Each field is labelled by a TextBlock, not by placeholder text. SukiUI 7.0.1 draws
               PART_Placeholder with a hardcoded Opacity of 0.5 and no Foreground binding at all,
               so PlaceholderForeground is never read (setting it to Red on the control changed
               no pixel) and the inherited colour is halved. Measured 2.51:1 against this panel;
               even pure black would reach only 3.89:1, under the 4.5:1 WCAG AA asks of small
               text. A placeholder also disappears as soon as the field is filled, taking the
               label with it just when the user wants to check what they typed. -->
          <StackPanel Spacing="3">
            <TextBlock Text="Document number" FontSize="12" />
            <TextBox x:Name="DocumentNumberBox" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="Date of birth (YYMMDD)" FontSize="12" />
            <TextBox x:Name="DateOfBirthBox" MaxLength="6" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="Date of expiry (YYMMDD)" FontSize="12" />
            <TextBox x:Name="DateOfExpiryBox" MaxLength="6" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="TRUST ANCHORS" FontSize="11" FontWeight="Bold" Margin="0,8,0,0" />
        <StackPanel Spacing="3">
          <TextBlock Text="CSCA directory (optional)" FontSize="12" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="TrustDirectoryBox" Grid.Column="0" />
            <Button x:Name="BrowseTrustButton" Grid.Column="1" Content="Browse" />
          </Grid>
        </StackPanel>
        <TextBlock x:Name="TrustHint" TextWrapping="Wrap" FontSize="11"
                   Text="MRTDScope ships no CSCA certificates. Without anchors the Document Signer chain is reported inconclusive, which is a statement about this inspector rather than the document." />

      </StackPanel>
    </ScrollViewer>

      <StackPanel Grid.Row="1" Margin="16,8,16,16" Spacing="12">
        <Button x:Name="InspectButton" Content="Inspect" HorizontalAlignment="Stretch"
                Classes="accent" />

        <Border Background="#20808080" CornerRadius="6" Padding="12">
          <StackPanel Spacing="6">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" IsVisible="False" Height="3" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"
                       Text="Ready." />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Results. -->
    <TabControl Grid.Column="1" Grid.Row="0" Margin="0,8,8,0">

      <TabItem Header="Checks">
        <ScrollViewer>
          <ItemsControl x:Name="ChecksList" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:CheckRow">
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="#18808080"
                        BorderThickness="3,0,0,0" BorderBrush="{Binding Accent}">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontFamily="Consolas,Menlo,monospace"
                                 Foreground="{Binding Accent}" Width="72" />
                      <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Reason}" IsVisible="{Binding HasReason}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" />
                    <Expander Header="Evidence" IsVisible="{Binding HasEvidence}" Margin="0,4,0,0">
                      <TextBlock Text="{Binding Evidence}" FontFamily="Consolas,Menlo,monospace"
                                 FontSize="11" TextWrapping="Wrap" />
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Document">
        <Grid ColumnDefinitions="Auto,*" Margin="16" ColumnSpacing="20">
          <StackPanel Grid.Column="0" Spacing="8">
            <Border Width="240" Height="300" Background="#18808080" CornerRadius="6">
              <Image x:Name="PortraitImage" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="PortraitNote" Width="240" TextWrapping="Wrap" FontSize="11" Text="No portrait read." />
          </StackPanel>
          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
              <TextBlock x:Name="HolderNameText" FontSize="20" FontWeight="SemiBold" Text="—" />
              <TextBlock x:Name="DocumentSummaryText" TextWrapping="Wrap" Text="" />
              <TextBlock Text="MRZ AS STORED ON THE CHIP" FontSize="11" FontWeight="Bold" Margin="0,8,0,0" />
              <TextBox x:Name="MrzText" IsReadOnly="True" AcceptsReturn="True"
                       FontFamily="Consolas,Menlo,monospace" FontSize="13" />
              <TextBlock TextWrapping="Wrap" FontSize="11"
                         Text="DG1 is covered by the security object, so a tampered MRZ is already caught by the data-group hash check. The name is a transliteration into a 37-character subset and routinely differs from the printed visual zone." />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="APDU trace">
        <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="8">
          <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11"
                     Text="Every exchange with the chip. Payloads that carry session key material are withheld: a full trace of the authentication commands plus the MRZ is enough to reconstruct the session keys and decrypt the rest." />
          <TextBox x:Name="TraceText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                   FontFamily="Consolas,Menlo,monospace" FontSize="11"
                   TextWrapping="NoWrap" />
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Summary and export. -->
    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Padding="16,10"
            Background="#14808080">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="SummaryText" Grid.Column="0" VerticalAlignment="Center"
                   TextWrapping="Wrap" FontSize="12"
                   Text="No inspection yet." />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ExportReportButton" Content="Export report" IsEnabled="False" />
          <Button x:Name="ExportTraceButton" Content="Export trace" IsEnabled="False" />
          <Button x:Name="ExportPortraitButton" Content="Export portrait" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
