<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Symbols live inside the assembly, so a publish directory holds no loose
         .pdb files that would otherwise be shipped in a release archive. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <Product>MRTDScope</Product>
    <Company>Momtazul Arefin</Company>
    <Authors>Momtazul Arefin</Authors>
    <Copyright>Copyright (c) 2026 Momtazul Arefin</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
